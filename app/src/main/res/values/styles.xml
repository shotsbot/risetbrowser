<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.RiSETBrowser" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/accent</item>
        
        <!-- Status Bar -->
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@color/toolbar_background</item>
        
        <!-- Navigation Bar -->
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:navigationBarColor">@color/background_primary</item>
        
        <!-- Window -->
        <item name="android:windowBackground">@color/background_primary</item>
        <item name="android:windowNoTitle">false</item>
        <item name="android:windowActionBar">true</item>
        
        <!-- Text Appearance -->
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_tertiary</item>
        
        <!-- Action Bar -->
        <item name="actionBarStyle">@style/ActionBarStyle</item>
        <item name="toolbarStyle">@style/ToolbarStyle</item>
    </style>

    <style name="Theme.RiSETBrowser.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Theme.RiSETBrowser.NightMode" parent="Theme.AppCompat">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:statusBarColor">@color/night_toolbar</item>
        <item name="android:navigationBarColor">@color/night_background</item>
        <item name="android:windowBackground">@color/night_background</item>
        <item name="android:textColorPrimary">@color/night_text_primary</item>
        <item name="android:textColorSecondary">@color/night_text_secondary</item>
    </style>

    <style name="ActionBarStyle" parent="Widget.AppCompat.ActionBar.Solid">
        <item name="background">@color/toolbar_background</item>
        <item name="android:elevation">4dp</item>
        <item name="elevation">4dp</item>
    </style>

    <style name="ToolbarStyle" parent="Widget.AppCompat.Toolbar">
        <item name="background">@color/toolbar_background</item>
        <item name="android:elevation">4dp</item>
        <item name="elevation">4dp</item>
    </style>

    <style name="RoundedButton" parent="Widget.AppCompat.Button.Colored">
        <item name="cornerRadius">24dp</item>
        <item name="android:textColor">@color/text_light</item>
    </style>

    <style name="AppBarOverlayStyle" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />
    <style name="PopupOverlayStyle" parent="ThemeOverlay.AppCompat.Light" />
</resources>
